# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (POSTGRES_USER owns the schema and runs the migrations)
POSTGRES_USER=invoice_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoices
POSTGRES_HOST_PORT=5436
# Password of invoice_app, the role the pipeline and the review page connect with.
# It can read the tables but only change data through the functions. Letters and digits only.
INVOICE_APP_PASSWORD=change-me-too

# n8n
N8N_VERSION=2.40.5
# Public base URL n8n should use for webhooks (with trailing slash)
N8N_WEBHOOK_URL=http://localhost:5681/
# Encrypts the credentials stored in n8n. Generate one (e.g. openssl rand -hex 24) and keep it safe:
# without it, saved credentials cannot be read.
N8N_ENCRYPTION_KEY=generate-a-long-random-string
N8N_HOST_PORT=5681

# ---- Used by scripts/setup-n8n.sh to create the n8n credentials ----
# Google AI Studio API key (Gemini reads the invoices)
GEMINI_API_KEY=your-gemini-api-key
# Google Cloud service account JSON key with read access to the Drive folder (Drive API enabled).
# Path to the file, kept OUTSIDE the repository; the key itself never goes in .env.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/outside/the/repo/drive-service-account.json
# Drive folder where invoices are dropped (the id at the end of the folder URL), shared with the service
# account's email as Viewer. Optional: without it only the upload API receives invoices.
DRIVE_FOLDER_ID=your-drive-folder-id
# Upload API: callers send it in the X-API-Key header (e.g. openssl rand -hex 24)
UPLOAD_API_KEY=generate-a-long-random-string

# Optional: reuse existing Docker volumes instead of creating new ones
# POSTGRES_VOLUME=ai_invoice_processing_postgres
# N8N_VOLUME=ai_invoice_processing_n8n
# INVOICE_FILES_VOLUME=ai_invoice_processing_files
