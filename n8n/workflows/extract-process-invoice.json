      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Gemini answers with JSON text in the first candidate; anything else is a failed extraction\nconst request = $('Build the request').first().json;\nconst response = $input.first().json;\nconst candidate = response.candidates?.[0];\nconst text = (candidate?.content?.parts ?? []).map(part => part.text ?? '').join('');\nconst base = { document_id: request.document_id, model: response.modelVersion ?? 'gemini',\n  duration_ms: Date.now() - request.started_at };\ntry {\n  if (!text) throw new Error(`Empty answer (finish reason: ${candidate?.finishReason ?? 'none'})`);\n  return [{ json: { ...base, ok: true, output: JSON.parse(text) } }];\n} catch (error) {\n  return [{ json: { ...base, ok: false, error: 'The model did not return valid JSON: ' + error.message } }];\n}"
      },
