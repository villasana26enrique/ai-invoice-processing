    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The file goes inline (base64) with the instructions and the exact JSON shape the answer must have\nconst PROMPT = \"You are reading a supplier invoice (a PDF, a phone photo or a scan) received by a dental clinic in the United States.\\n\\nExtract exactly what is printed. Do not calculate, correct or complete anything: if the printed total does not match the line items, return the printed total. Every check happens later, in the accounting system.\\n\\n- supplier_name: the company that issued the invoice (not the BILL TO customer), as printed.\\n- supplier_tax_id: the supplier's EIN (NN-NNNNNNN) only if it is printed on the invoice; otherwise null.\\n- invoice_number: as printed, with its prefix.\\n- invoice_date and due_date: YYYY-MM-DD. due_date is null when it says \\\"upon receipt\\\" or is not printed.\\n- If a date is covered, smudged, blurred or cut off, return null for it. Never work it out from other dates or from the payment terms.\\n- currency: ISO code; USD when amounts use $ and nothing says otherwise.\\n- subtotal, tax, shipping, total: plain numbers, no symbols or thousands separators. tax is 0 when printed as 0; shipping is 0 when there is no shipping line.\\n- lines: every line item on every page, in order. quantity and unit_price are null when the invoice does not show them; amount is the line total as printed.\\n\\nAny value you cannot read with confidence is null. A null is fixed by a person in seconds; a guess may be paid without anyone noticing.\";\nconst SCHEMA = {\n  \"type\": \"OBJECT\",\n  \"properties\": {\n    \"supplier_name\": {\n      \"type\": \"STRING\",\n      \"nullable\": true\n    },\n    \"supplier_tax_id\": {\n      \"type\": \"STRING\",\n      \"nullable\": true\n    },\n    \"invoice_number\": {\n      \"type\": \"STRING\",\n      \"nullable\": true\n    },\n    \"invoice_date\": {\n      \"type\": \"STRING\",\n      \"nullable\": true,\n      \"description\": \"YYYY-MM-DD\"\n    },\n    \"due_date\": {\n      \"type\": \"STRING\",\n      \"nullable\": true,\n      \"description\": \"YYYY-MM-DD\"\n    },\n    \"currency\": {\n      \"type\": \"STRING\",\n      \"nullable\": true\n    },\n    \"subtotal\": {\n      \"type\": \"NUMBER\",\n      \"nullable\": true\n    },\n    \"tax\": {\n      \"type\": \"NUMBER\",\n      \"nullable\": true\n    },\n    \"shipping\": {\n      \"type\": \"NUMBER\",\n      \"nullable\": true\n    },\n    \"total\": {\n      \"type\": \"NUMBER\",\n      \"nullable\": true\n    },\n    \"lines\": {\n      \"type\": \"ARRAY\",\n      \"items\": {\n        \"type\": \"OBJECT\",\n        \"properties\": {\n          \"description\": {\n            \"type\": \"STRING\",\n            \"nullable\": true\n          },\n          \"quantity\": {\n            \"type\": \"NUMBER\",\n            \"nullable\": true\n          },\n          \"unit_price\": {\n            \"type\": \"NUMBER\",\n            \"nullable\": true\n          },\n          \"amount\": {\n            \"type\": \"NUMBER\",\n            \"nullable\": true\n          }\n        },\n        \"required\": [\n          \"description\",\n          \"quantity\",\n          \"unit_price\",\n          \"amount\"\n        ],\n        \"propertyOrdering\": [\n          \"description\",\n          \"quantity\",\n          \"unit_price\",\n          \"amount\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"supplier_name\",\n    \"supplier_tax_id\",\n    \"invoice_number\",\n    \"invoice_date\",\n    \"due_date\",\n    \"currency\",\n    \"subtotal\",\n    \"tax\",\n    \"shipping\",\n    \"total\",\n    \"lines\"\n  ],\n  \"propertyOrdering\": [\n    \"supplier_name\",\n    \"supplier_tax_id\",\n    \"invoice_number\",\n    \"invoice_date\",\n    \"due_date\",\n    \"currency\",\n    \"subtotal\",\n    \"tax\",\n    \"shipping\",\n    \"total\",\n    \"lines\"\n  ]\n};\nconst item = $input.first();\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst body = {\n  contents: [{ role: 'user', parts: [\n    { inlineData: { mimeType: item.json.mime_type, data: buffer.toString('base64') } },\n    { text: PROMPT },\n  ] }],\n  generationConfig: { responseMimeType: 'application/json', responseSchema: SCHEMA },\n};\nreturn [{ json: { ...item.json, body, started_at: Date.now() }, binary: item.binary }];"
      },
