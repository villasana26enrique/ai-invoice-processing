        "language": "javaScript",
        "jsCode": "// sha256 of the bytes: the same invoice sent twice (by Drive and by the web) is one document\nconst crypto = require('crypto');\nconst item = $input.first();\nconst start = item.json;\nconst fail = (error) => [{ json: { ok: false, error, file_name: start.file_name ?? null } }];\nif (!item.binary?.data) return fail('No file attached.');\n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst fileName = start.file_name || item.binary.data.fileName || 'invoice';\nconst byExtension = { pdf: 'application/pdf', jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp' };\nconst extension = fileName.includes('.') ? fileName.split('.').pop().toLowerCase() : '';\nconst mimeType = byExtension[extension] ?? start.mime_type ?? item.binary.data.mimeType;\nconst storedExtension = Object.entries(byExtension).find(([, type]) => type === mimeType)?.[0] ?? 'bin';\nconst sha256 = crypto.createHash('sha256').update(buffer).digest('hex');\n\nreturn [{\n  json: {\n    ok: true, source: start.source || 'upload', source_id: start.source_id || sha256, file_name: fileName,\n    mime_type: mimeType, sha256, storage_path: `${sha256}.${storedExtension}`,\n  },\n  binary: item.binary,\n}];"
      },
