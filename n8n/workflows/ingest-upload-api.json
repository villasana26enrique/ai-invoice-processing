        "language": "javaScript",
        "jsCode": "// multipart/form-data: file (required), source_id (optional: the caller's own id for the invoice)\nconst item = $input.first();\nconst fields = item.json.body ?? {};\nconst keys = Object.keys(item.binary ?? {});\nconst fail = (message) => [{ json: { ok: false, message } }];\nif (keys.length !== 1) return fail('Send one invoice as a multipart/form-data field named \"file\".');\nconst file = item.binary[keys[0]];\nconst fileName = file.fileName ?? 'invoice';\nif (!/\\.(pdf|jpe?g|png|webp)$/i.test(fileName)) return fail('Send a PDF or a photo (JPG, PNG or WebP).');\nreturn [{ json: { ok: true, source: 'upload', source_id: fields.source_id || '', file_name: fileName },\n          binary: { data: file } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
